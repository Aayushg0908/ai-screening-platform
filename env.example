# ============================================================
# Copy to .env and fill in. NEVER commit .env
# ============================================================

# ---- Database: Neon (https://neon.tech) free tier ----
# Neon requires sslmode=require. Use the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---- LLM: Groq (https://console.groq.com) free ----
# Groq deprecated all llama-* models in 2026 - they now 404. Use gpt-oss-120b.
# GROQ_API_KEYS (plural) takes a comma-separated pool for higher throughput;
# GROQ_API_KEY (singular) still works as a one-key pool.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# ---- LLM fallback: Mistral (https://console.mistral.ai) free tier ----
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest

# ---- GitHub: fine-grained PAT, public-repo read only ----
# Unauthenticated = 60 req/hr. Authenticated = 5000 req/hr.
GITHUB_TOKEN=

# ---- Email transport (https://brevo.com free tier, 300/day) ----
# Render blocks outbound SMTP at the network level - confirmed against two
# independent providers (Gmail, then Brevo), both working fine locally and
# failing identically from Render regardless of port or IP whitelisting.
# "api" (default) sends over Brevo's HTTPS API instead - same account, same
# verified sender, same "send to anyone" capability, just port 443 like
# every other outbound call this app makes. "smtp" is kept fully working for
# local dev / as a demonstrated fallback.
EMAIL_TRANSPORT=api
# Brevo's v3 API key (Settings > SMTP & API > API Keys tab) - a DIFFERENT
# credential from SMTP_PASSWORD below, despite both being Brevo credentials
# for the same account. Required when EMAIL_TRANSPORT=api.
BREVO_API_KEY=

# ---- Email: SMTP relay - Brevo, only used when EMAIL_TRANSPORT=smtp ----
# Brevo's relay is a single stable host, not a round-robin pool, and needs
# only single-sender verification (one address) to send to any recipient -
# unlike an HTTP provider's no-domain sandbox, which only sends to yourself.
# Get SMTP_USER/SMTP_PASSWORD from Brevo's dashboard under SMTP & API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login
SMTP_PASSWORD=your-brevo-smtp-key
# The verified single-sender address - NOT the same as SMTP_USER. Brevo's
# SMTP login is an account identifier, not necessarily a deliverable mailbox;
# this is what actually appears in the From header and must be verified
# under Brevo's Senders settings.
SMTP_FROM=your.verified.sender@example.com
SMTP_FROM_NAME=Visl AI Labs Recruitment
# Dev/testing only: also Bcc every outgoing email to this address (kept out of
# visible headers) so you can inspect real outgoing mail. Empty by default.
EMAIL_BCC=

# ---- The assessment link mailed to shortlisted candidates ----
TEST_LINK_URL=https://forms.gle/your-google-form-id

# ---- Google Calendar OAuth ----
# From the OAuth "Desktop app" client you create in Google Cloud Console.
# Obtain GOOGLE_REFRESH_TOKEN by running: python scripts/google_oauth_setup.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---- App config ----
# Read by the FRONTEND only, to reach the backend. Differs between local dev
# and deployment: locally it's http://localhost:8000; on Render it's the
# backend service's own public URL (e.g. https://my-backend.onrender.com).
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- CORS: origins allowed to call the backend API ----
# Comma-separated. Include both the deployed frontend and localhost so local
# dev keeps working after deploy, e.g. on Render:
#   CORS_ORIGINS=https://my-frontend.onrender.com,http://localhost:8501
CORS_ORIGINS=http://localhost:8501

# ---- Scoring weights (must each sum to 1.0) ----
W_RESUME_JD=0.40
W_GITHUB=0.25
W_PROJECTS=0.20
W_ACADEMICS=0.15

W_PRE_TEST=0.60
W_TEST_LA=0.20
W_TEST_CODE=0.20

# ---- Shortlisting thresholds ----
SHORTLIST_TOP_N=5
TEST_PASS_THRESHOLD=70.0
